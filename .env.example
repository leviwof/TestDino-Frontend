# ==============================================================================
# TestDino Frontend — Environment Configuration (.env.example)
# ==============================================================================

# Base URL of the backend API. This is a PUBLIC value (exposed to the browser),
# not a secret. Next.js bakes it in at BUILD time, so set it before `next build`.
#
# Defaults to the deployed backend if unset (see lib/config.ts).
# For local development against a local backend, use http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=https://testdino-backend.onrender.com
